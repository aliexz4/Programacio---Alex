#Para separar parragrafs
print("")


#Numeros
n1=int(input ("Escriu un numero: "))
n2=int(input ("Escriu un altre numero: "))
suma=n1+n2



#Las claus ({}) se usan para definir comienzo y final
if(suma>10): {
    print("La seva suma és més gran que 10")
}
else: {
    print("La seva suma és més petita que 10")
}



#El or se usa para decir "o"
if(suma>8 or suma<4): {
    print("La seva suma és més gran que 8 o més petita que 4")
}

#El and se usa para decir "y"
if(suma>12 and suma<18): {
    print("La seva suma és més gran que 12 i més petita que 18")
}

#El not se usa para decir "no"
if(not suma == 13): {
    print("La seva suma no és igual a 13")
}

if(not suma == 15): {
    print("La seva suma no és igual a 15")
}
    
elif (suma == 15): {
    print ("La suma és igual a 15")
}
    
else: {
    print ("La suma no és igual a 15 ni a 13")
}


